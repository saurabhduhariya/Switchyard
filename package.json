{
  "name": "ag-switchyard",
  "displayName": "Switchyard – Account Switcher for Antigravity",
  "description": "Multi-account switcher sidebar for the Google Antigravity IDE",
  "publisher": "saurabhduhariya",
  "version": "0.1.3",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/saurabhduhariya/Switchyard"
  },
  "bugs": {
    "url": "https://github.com/saurabhduhariya/Switchyard/issues"
  },
  "homepage": "https://github.com/saurabhduhariya/Switchyard#readme",
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#1e1e2e",
    "theme": "dark"
  },
  "keywords": [
    "antigravity",
    "account",
    "switcher",
    "multi-account",
    "google",
    "gemini",
    "ai"
  ],
  "engines": {
    "vscode": "^1.107.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "agSwitchyard",
          "title": "Accounts",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "agSwitchyard": [
        {
          "type": "webview",
          "id": "agSwitchyard.panel",
          "name": "Accounts"
        }
      ]
    },
    "commands": [
      {
        "command": "switchyard.addAccount",
        "title": "Switchyard: Add Account"
      },
      {
        "command": "switchyard.switchAccount",
        "title": "Switchyard: Switch Account…"
      },
      {
        "command": "switchyard.refresh",
        "title": "Switchyard: Refresh"
      },
      {
        "command": "switchyard.restoreBackup",
        "title": "Switchyard: Restore Last Backup"
      },
      {
        "command": "switchyard.addNewAccount",
        "title": "Switchyard: Add New Account (Sign Out & Switch)"
      },
      {
        "command": "switchyard.openBackupsFolder",
        "title": "Switchyard: Open Backups Folder"
      },
      {
        "command": "switchyard.importAccount",
        "title": "Switchyard: Import Account from Database / Backup"
      },
      {
        "command": "switchyard.openSettings",
        "title": "Switchyard: Settings"
      }
    ],
    "walkthroughs": [
      {
        "id": "switchyard.walkthrough",
        "title": "Getting Started with Switchyard",
        "description": "Learn how to manage and switch between multiple Google accounts in Antigravity IDE",
        "steps": [
          {
            "id": "switchyard.step.openPanel",
            "title": "Open Switchyard Accounts Panel",
            "description": "Click the Accounts icon on the Activity Bar to view your active account and manage saved profiles.\n[Open Switchyard](command:agSwitchyard.panel.focus)",
            "media": {
              "svg": "media/walkthrough-panel.svg"
            }
          },
          {
            "id": "switchyard.step.saveAccount",
            "title": "Save Your Current Account",
            "description": "Switchyard automatically detects your active Google login. Click 'Save Current Login' to store it securely.\n[Save Account](command:switchyard.addAccount)",
            "media": {
              "svg": "media/walkthrough-save.svg"
            }
          },
          {
            "id": "switchyard.step.addSecond",
            "title": "Add a Second Account",
            "description": "Click 'Add Another Account' to sign out cleanly, log in with your second Google account, and save it.\n[Add New Account](command:switchyard.addNewAccount)",
            "media": {
              "svg": "media/walkthrough-add.svg"
            }
          },
          {
            "id": "switchyard.step.switch",
            "title": "Switch Between Accounts Instantly",
            "description": "Switch anytime with 1 click from the sidebar or via the Command Palette.\n[Switch Account](command:switchyard.switchAccount)",
            "media": {
              "svg": "media/walkthrough-switch.svg"
            }
          }
        ]
      }
    ],
    "configuration": {

      "title": "Switchyard",
      "properties": {
        "switchyard.mode": {
          "type": "string",
          "default": "tokenSwap",
          "enum": [
            "tokenSwap",
            "profile"
          ],
          "description": "tokenSwap = switch accounts in the same window (fast restart). profile = launch isolated windows side-by-side."
        },
        "switchyard.confirmBeforeSwitch": {
          "type": "boolean",
          "default": true,
          "description": "Ask for confirmation before switching accounts in tokenSwap mode."
        },
        "switchyard.backupRetention": {
          "type": "number",
          "default": 5,
          "description": "Number of state.vscdb backups to retain."
        },
        "switchyard.maskEmails": {
          "type": "boolean",
          "default": false,
          "description": "Mask email addresses in the accounts panel and status bar (e.g. u***@domain.com)."
        },
        "switchyard.executablePath": {
          "type": "string",
          "default": "",
          "description": "Custom path to the Antigravity IDE executable binary. Leave empty for automatic detection."
        }
      }
    }
  },
  "scripts": {
    "build:ext": "node esbuild.mjs",
    "build:web": "npm --prefix webview run build",
    "build": "run-s build:ext build:web",
    "watch:ext": "node esbuild.mjs --watch",
    "watch:web": "npm --prefix webview run build -- --watch",
    "watch": "run-p watch:ext watch:web",
    "lint": "eslint src",
    "test": "vitest run",
    "test:int": "node ./out/test/integration/runTests.js",
    "package": "vsce package --no-dependencies",
    "vscode:prepublish": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "@types/sql.js": "^1.4.11",
    "@types/vscode": "^1.107.0",
    "@typescript-eslint/eslint-plugin": "^8.71.0",
    "@typescript-eslint/parser": "^8.71.0",
    "@vscode/test-electron": "^2.5.2",
    "@vscode/vsce": "^3.9.2",
    "esbuild": "^0.28.2",
    "eslint": "^10.11.0",
    "npm-run-all2": "^8.0.4",
    "ovsx": "^1.1.1",
    "prettier": "^3.9.9",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "sql.js": "^1.14.2"
  }
}
